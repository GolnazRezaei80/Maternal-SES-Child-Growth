{com}. program define calc_ratio_2_3, rclass
{txt}  1{com}. 
.     regress fitted_values_bmi_mi fitted_values_waz_mi fitted_values_haz_mi if Growth_Month==2 & SES==3
{txt}  2{com}. 
.     return scalar ratiocoef = abs(_b[fitted_values_waz_mi] / _b[fitted_values_haz_mi])
{txt}  3{com}. 
. end

. 
. 
. 
. tempfile boot_results_2_3

. 
. save `boot_results_2_3', emptyok replace
